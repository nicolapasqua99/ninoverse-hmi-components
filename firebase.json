{
    "hosting": [
        {
            "target": "demo",
            "public": "dist-site",
            "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
            "rewrites": [
                { "source": "/demo/**", "destination": "/demo/index.html" },
                { "source": "**", "destination": "/index.html" }
            ]
        }
    ]
}
